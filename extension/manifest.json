{
  "manifest_version": 3,
  "name": "Shy Safari 自動同步",
  "version": "1.0.0",
  "description": "用 Chrome 帳號同步 Shy Safari 的設定和紀錄，換電腦也能接著用。",
  "key": "",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shy Safari 自動同步"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.shysafari.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
